# ===========================================
# 🔐 Inventory Management System - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# Do NOT commit .env to version control (it's in .gitignore)
# ===========================================

# Supabase Database Configuration
# Get these from your Supabase project dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-public-key-here

# Server Configuration
PORT=5000

# JWT Authentication Configuration
# Generate a strong secret using: openssl rand -base64 32 (or node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars-long
JWT_EXPIRES_IN=7d

